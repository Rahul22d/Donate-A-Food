<!--<?xml version="1.0" encoding="utf-8"?>-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/history_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="@drawable/item_product_background">

    <!-- Food Image -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/foodImageH"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="Food Image"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/RoundedImageView"
        tools:srcCompat="@tools:sample/avatars" />

    <!-- Food Name -->
    <TextView
        android:id="@+id/foodNameH"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:text="Food Name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/foodImageH"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Food Quantity -->
    <TextView
        android:id="@+id/foodQuantityH"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Quantity"
        android:textSize="15sp"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@id/foodNameH"
        app:layout_constraintEnd_toEndOf="@id/foodNameH"
        app:layout_constraintTop_toBottomOf="@id/foodNameH" />

    <!-- Food Date -->
    <TextView
        android:id="@+id/foodDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="Date"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="@id/foodQuantityH"
        app:layout_constraintEnd_toEndOf="@id/foodQuantityH"
        app:layout_constraintTop_toBottomOf="@id/foodQuantityH"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
